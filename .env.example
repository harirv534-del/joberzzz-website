# SUPABASE CONFIGURATION
# Provide your Supabase project URL and public Anon Key
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key"

# GROQ_API_KEY: Server-side API key for Groq AI inference (ATS resume analyzer, job matching, interview prep)
# Groq key must NEVER be exposed to the client bundle.
GROQ_API_KEY="gsk_your_groq_api_key"

# APP_URL: Self-referential URL where the applet runs
APP_URL="http://localhost:3000"
